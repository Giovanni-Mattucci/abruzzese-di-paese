# "/<repo>/" for a GitHub project site, "/" for a user site or custom domain.
VITE_BASE_PATH=/
# Absolute site URL used for canonical links, sitemap and JSON-LD (no trailing slash).
VITE_SITE_URL=https://giovanni-mattucci.github.io/abruzzese-di-paese
# Repository URL for edit and issue links.
VITE_REPO_URL=https://github.com/Giovanni-Mattucci/abruzzese-di-paese
# Feature flags: "true" | "false". Override at runtime with ?flag_NAME=1 or localStorage flag:NAME.
VITE_FLAG_DESIGN_V2=false
# Cloudflare Web Analytics token. Leave empty for no analytics; the official site sets it in the
# deploy workflow from the CF_ANALYTICS_TOKEN repository variable. Forks use their own or none.
VITE_CF_ANALYTICS_TOKEN=

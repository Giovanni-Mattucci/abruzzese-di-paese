{
  "name": "@adp/web",
  "version": "0.0.0",
  "private": true,
  "description": "Abruzzese di paese web application",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm prerender && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "prerender": "tsx scripts/prerender.ts"
  },
  "dependencies": {
    "@adp/data": "workspace:*",
    "@adp/search": "workspace:*",
    "@mannaggia/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "i18next": "27.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "18.0.0",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "tsx": "^4.23.15"
  }
}
